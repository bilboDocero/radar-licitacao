NODE_ENV=development
DATABASE_URL=postgresql://radar:radar_local@localhost:5432/radar
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
OIDC_ISSUER=http://localhost:8080/realms/radar
OIDC_JWKS_URL=http://localhost:8080/realms/radar/protocol/openid-connect/certs
OIDC_AUDIENCE=radar-api
NUXT_API_BASE=http://localhost:4000/api/v1
NUXT_REDIS_URL=redis://localhost:6379
NUXT_OIDC_ISSUER=http://localhost:8080/realms/radar
NUXT_OIDC_CLIENT_ID=radar-web
NUXT_OIDC_CLIENT_SECRET=local-development-secret
NUXT_WEB_ORIGIN=http://localhost:3000
NUXT_SESSION_PASSWORD=local-only-change-this-secret-at-least-32-characters
COLLECTION_ENABLED=false
COLLECTION_INTERVAL_MS=3600000
PNCP_LOOKBACK_DAYS=2
OTEL_SERVICE_NAME=radar
# Optional OTLP HTTP collector. Leave empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Inteligência Artificial e Processamento Documental
AI_ENABLED=true
AI_DEFAULT_PROVIDER=mock
AI_DEFAULT_MODEL=mock-brief-v1
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_MAX_INPUT_TOKENS=32000
AI_MAX_OUTPUT_TOKENS=4000
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=3
AI_DAILY_BUDGET_USD=10
AI_MONTHLY_BUDGET_USD=100

# Chaves dos provedores de IA (configurar apenas para provedores ativos)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=