NODE_ENV=development
DATABASE_URL=postgresql://radar:radar_local@localhost:5432/radar
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
OIDC_ISSUER=http://localhost:8080/realms/radar
OIDC_JWKS_URL=http://localhost:8080/realms/radar/protocol/openid-connect/certs
OIDC_AUDIENCE=radar-api
NUXT_API_BASE=http://localhost:4000/api/v1
NUXT_REDIS_URL=redis://localhost:6379
NUXT_OIDC_ISSUER=http://localhost:8080/realms/radar
NUXT_OIDC_CLIENT_ID=radar-web
NUXT_OIDC_CLIENT_SECRET=local-development-secret
NUXT_WEB_ORIGIN=http://localhost:3000
NUXT_SESSION_PASSWORD=local-only-change-this-secret-at-least-32-characters
COLLECTION_ENABLED=false
COLLECTION_INTERVAL_MS=3600000
PNCP_LOOKBACK_DAYS=2
OTEL_SERVICE_NAME=radar
