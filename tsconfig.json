{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist", "apps/web", "radar-licitacao"]
}
